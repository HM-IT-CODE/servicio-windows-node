{
  "name": "aruna-winsvc",
  "version": "1.0.2",
  "description": "Register Node.js apps as native Windows services, and ship them as a double-click installer. No NSSM, no .NET, zero dependencies.",
  "keywords": [
    "windows",
    "service",
    "win32",
    "node",
    "deployment",
    "production",
    "scm",
    "installer",
    "setup",
    "nssm",
    "node-windows",
    "winsw",
    "aruna"
  ],
  "author": "Henry Moreno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HM-IT-CODE/servicio-windows-node.git"
  },
  "bugs": {
    "url": "https://github.com/HM-IT-CODE/servicio-windows-node/issues"
  },
  "homepage": "https://github.com/HM-IT-CODE/servicio-windows-node#readme",
  "bin": {
    "aruna-winsvc": "dist/main.js",
    "aruna": "dist/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "bin/node-winsvc-core.exe",
    "bin/node-winsvc-setup.exe",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:rust": "cd rust && cargo build --release",
    "bundle:exe": "copy rust\\target\\release\\node-winsvc-core.exe bin\\",
    "dev": "ts-node src/main.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
